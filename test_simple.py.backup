#!/usr/bin/env python3
"""
Jednoduchý testovací skript pro memory-agent API s použitím urllib
"""

import json
import urllib.request
import urllib.error
import uuid

# URL lokálního API serveru
API_URL = "http://localhost:8123"

def test_health():
    """Zkontroluje zdraví API serveru."""
    try:
        with urllib.request.urlopen(f"{API_URL}/health") as response:
            data = json.loads(response.read().decode())
            print(f"Health check: {response.getcode()}")
            print(data)
            return response.getcode() == 200
    except urllib.error.URLError as e:
        print(f"Health check selhal: {e}")
        return False

def test_chat():
    """Otestuje endpoint /chat s jednoduchým dotazem."""
    # Vytvoříme jedinečné user_id pro testování
    user_id = str(uuid.uuid4())
    
    # Připravíme data pro požadavek
    data = {
        "messages": [
            {
                "role": "user",
                "content": "Zapamatuj si, že se jmenuji Karel a mám rád programování v Pythonu."
            }
        ],
        "user_id": user_id,
        "model": "anthropic/claude-3-haiku-20240307",  # Použijeme menší model pro rychlejší odpověď
        "temperature": 0.7
    }
    
    # Pošleme požadavek na chat endpoint
    print(f"\nPosílám chat požadavek s user_id: {user_id}")
    
    try:
        req = urllib.request.Request(
            f"{API_URL}/chat",
            data=json.dumps(data).encode('utf-8'),
            headers={'Content-Type': 'application/json'}
        )
        
        with urllib.request.urlopen(req) as response:
            result = json.loads(response.read().decode())
            print(f"Chat požadavek úspěšný: {response.getcode()}")
            
            # Vytiskneme odpověď asistenta
            assistant_message = next((msg for msg in result["messages"] if msg["role"] == "assistant"), None)
            if assistant_message:
                print("\nOdpověď asistenta:")
                print(assistant_message["content"])
            
            # Zkontrolujeme, zda byly vytvořeny nějaké tool_calls pro ukládání paměti
            tool_calls = next((msg.get("tool_calls") for msg in result["messages"] if "tool_calls" in msg), None)
            if tool_calls:
                print("\nTool calls:")
                print(json.dumps(tool_calls, indent=2))
            
            # Zkusíme poslat druhý požadavek, abychom otestovali, zda se paměť uložila
            second_data = {
                "messages": [
                    {
                        "role": "user",
                        "content": "Jak se jmenuji a co mám rád?"
                    }
                ],
                "user_id": user_id,  # Použijeme stejné user_id pro kontinuitu
                "model": "anthropic/claude-3-haiku-20240307",
                "temperature": 0.7
            }
            
            print("\nPosílám druhý chat požadavek pro ověření paměti...")
            
            second_req = urllib.request.Request(
                f"{API_URL}/chat",
                data=json.dumps(second_data).encode('utf-8'),
                headers={'Content-Type': 'application/json'}
            )
            
            try:
                with urllib.request.urlopen(second_req) as second_response:
                    second_result = json.loads(second_response.read().decode())
                    second_message = next((msg for msg in second_result["messages"] if msg["role"] == "assistant"), None)
                    if second_message:
                        print("\nOdpověď na druhý požadavek:")
                        print(second_message["content"])
                    return True
            except urllib.error.URLError as e:
                print(f"Druhý požadavek selhal: {e}")
                return False
            
    except urllib.error.URLError as e:
        print(f"Chat požadavek selhal: {e}")
        try:
            error_data = json.loads(e.read().decode())
            print(json.dumps(error_data, indent=2))
        except:
            print(f"Status: {e.code}")
        return False

if __name__ == "__main__":
    print("Testování memory-agent API...")
    
    # Otestujeme health endpoint
    if test_health():
        print("\n✅ Health check úspěšný")
    else:
        print("\n❌ Health check selhal")
        exit(1)
    
    # Otestujeme chat endpoint
    if test_chat():
        print("\n✅ Chat test úspěšný")
    else:
        print("\n❌ Chat test selhal")
        exit(1)
    
    print("\nVšechny testy proběhly úspěšně!")
services:
  api:
    build: .
    container_name: memory-agent-api
    ports:
      - "8123:8000"
    depends_on:
      - postgres
      - redis
    environment:
      - LANGSMITH_API_KEY=${LANGSMITH_API_KEY}
      - LANGSMITH_PROJECT=${LANGSMITH_PROJECT}
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - DATABASE_URI=postgresql://postgres:postgres@postgres:5432/memory_agent
      - REDIS_URI=redis://redis:6379/0
      - PYTHONASYNCIODEBUG=1
      - LANGCHAIN_TRACING_V2=true
      - LOG_LEVEL=DEBUG
      - ASYNCIO_EVENT_LOOP=uvloop

  postgres:
    image: pgvector/pgvector:pg16
    container_name: memory-agent-postgres
    environment:
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=postgres
      - POSTGRES_DB=memory_agent
    volumes:
      - postgres_data:/var/lib/postgresql/data

  redis:
    image: redis:6
    container_name: memory-agent-redis

volumes:
  postgres_data: